        {"id": "construction_spend_private_nonres", "label": "US private nonresidential construction spending (USD m, SAAR)", "source": "fred", "fred_id": "PNRESCONS", "good_for": "nonres_demand", "staleness_max_days": 100},
        {"id": "construction_spend_nonres_total", "label": "US total nonresidential construction spending (USD m, SAAR)", "source": "fred", "fred_id": "TLNRESCONS", "good_for": "nonres_demand", "staleness_max_days": 100},
