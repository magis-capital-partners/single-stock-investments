    "aggregates_infrastructure": {
      "label": "Crushed stone -> local haul monopoly -> housing + public infrastructure demand",
      "description": "Demand and cost chain behind aggregates/cement (VMC, MLM, CRH, AMRZ, EXP, KNF, ACA, USLM, GVA, ROAD, CX). Freight caps the economic haul radius near 25 miles, so each quarry is a local oligopoly and the thesis is price/ton compounding above cost/ton. Residential is the cyclical leg, public highway spend the counter-cyclical one. The mining PPIs are an independent third-party read on pricing: divergence from company-reported ASP is the tell. No fallbacks on the monthly series -- they have no daily equivalent and must be allowed to go visibly stale rather than be silently substituted.",
      "series": [
        {"id": "ppi_crushed_limestone", "label": "PPI: crushed and broken limestone mining (index)", "source": "fred", "fred_id": "PCU212312212312", "good_for": "aggregates_pricing", "staleness_max_days": 90, "note": "Independent read on crushed-stone pricing; cross-check against company freight-adjusted ASP"},
        {"id": "ppi_sand_gravel_mining", "label": "PPI: construction sand and gravel mining (index)", "source": "fred", "fred_id": "PCU212321212321", "good_for": "aggregates_pricing", "staleness_max_days": 90},
        {"id": "ppi_sand_gravel_stone", "label": "PPI: construction sand, gravel and crushed stone (index)", "source": "fred", "fred_id": "WPU1321", "good_for": "aggregates_pricing", "staleness_max_days": 90, "note": "Longer history than the industry PPIs; use for cycle work"},
