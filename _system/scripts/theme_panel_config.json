        {"id": "agi_years_ahead", "label": "AGI expert-horizon years ahead (public quotes)", "source": "expert_horizon", "domain": "agi", "good_for": "horizon_orientation", "staleness_max_days": 180, "optional": true},
        {"id": "robotaxi_years_ahead", "label": "Robotaxi expert-horizon years ahead (public quotes)", "source": "expert_horizon", "domain": "robotaxi", "good_for": "horizon_orientation", "staleness_max_days": 180, "optional": true}
      ]
