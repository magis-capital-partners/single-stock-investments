        {"id": "housing_starts", "label": "US housing starts (thousands, SAAR)", "source": "fred", "fred_id": "HOUST", "good_for": "residential_demand", "staleness_max_days": 85},
        {"id": "housing_starts_sf", "label": "US single-family housing starts (thousands, SAAR)", "source": "fred", "fred_id": "HOUST1F", "good_for": "residential_demand", "staleness_max_days": 85, "note": "Single-family consumes far more aggregate per unit than multi-family"},
