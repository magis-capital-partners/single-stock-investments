<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>

    

    	function getCookie(cname) {

		    var name = cname + "=";

		    var ca = document.cookie.split(';');

		    for(var i=0; i<ca.length; i++) {

		        var c = ca[i];

		        while (c.charAt(0)==' ') c = c.substring(1);

		        if (c.indexOf(name) == 0) return c.substring(name.length,c.length);

		    }

		    return "";

		} 

		

		function setSessionCookie(cname, cvalue) {

		    document.cookie = cname + "=" + cvalue + "; ";

		}

		

		function setCookie(cname, cvalue, exdays) {

		    var d = new Date();

		    d.setTime(d.getTime() + (exdays*24*60*60*1000));

		    var expires = "expires="+d.toUTCString();

		    document.cookie = cname + "=" + cvalue + "; " + expires;

		} 

		

		function showLetter() {

			$("#hideAllLetterDiv").show();

			$("#seeAllLetterDiv").hide();	

			$("#moreIcahnologyLetter").show();

		}

		

		function hideLetter() {

			$("#hideAllLetterDiv").hide();

			$("#seeAllLetterDiv").show();

			$("#moreIcahnologyLetter").hide();

		}

		

		var params = {};

		

		if (location.search) {

		    var parts = location.search.substring(1).split('&');

		

		    for (var i = 0; i < parts.length; i++) {

		        var nv = parts[i].split('=');

		        if (!nv[0]) continue;

		        params[nv[0]] = nv[1] || true;

		    }

		}



		

		function printPage() { 

			$("header").css("position","relative");
			$("header").css("padding-bottom","20px");

		    $("body").css("margin-top","0px");

			$("form.search-form").hide();

			$(".social").hide();

			$("#menu-main-menu").hide();

			$(".logo").css("bottom","0px").css("top","5px");

			$(".tags").hide();

			$(".related-posts").hide();

			$(".share").hide();

			$("address").hide();

                        $(".copyright").html("<strong>Copyright © 2015 • Carl Icahn</strong>");

			//window.print();	

                        //window.onfocus=function(){ window.close();}

		}

		

		function showLegalPopup() {

			$("#siteLegalFormOverlay").show();

			$("#siteLegalTextDiv").show();	

			document.body.scroll = 'no';		

		}

		

		function hideLegal() {

			$("#siteLegalFormOverlay").hide();

			$("#siteLegalTextDiv").hide();	

			document.body.scroll = 'yes';

			setSessionCookie("legalRead", "true");

		}

	

		$("#AcceptLegalLink").click(function(e){

			 //var a_href = $(this).attr('href');

			 hideLegal();

			  e.preventDefault();

			 });

		

		$(document).ready(function() {

			if (getCookie("icahnologyVisited") == "true") {

				hideLetter();

			}

			else {

				setSessionCookie("icahnologyVisited", "true");

				showLetter();

			}

                        $(".fa-print").show(); // Enable print function on post detail for javascript enabled browser.

			if (params.sstprint == "true") {

				printPage();

			}

			/* Legal pop-up */

			if (getCookie("legalRead") != "true") {

			    console.log("legalRead cookie not set");

				showLegalPopup();

			}

			

		});

		

		$("#ShowLetterLink").click(function(e){

			 //var a_href = $(this).attr('href');

			 showLetter();

			  e.preventDefault();

			 });

		

		$("#HideLetterLink").click(function(e){

			 //var a_href = $(this).attr('href');

			 hideLetter();

			  e.preventDefault();

			 });

			 

			 

			 

$("#subscribeLetterLink").click(function(e){

  //var a_href = $(this).attr('href');

  showSignUpForm();

   e.preventDefault();

  });

 

 $("#siteSubscribeFormOverlay").click(function(e){

  //var a_href = $(this).attr('href');

  hideSignUpForm();

   e.preventDefault();

  });

  

  

  

  

     function showSignUpForm () {

         

     $("#siteSubscribeFormOverlay").show();

     $("#siteSubscribeFormDiv").show();    

     }

  

     function hideSignUpForm () {

     $("#siteSubscribeFormOverlay").hide();

     $("#siteSubscribeFormDiv").hide();    

     }			 

			 

	</script> 
	
