                                <div class="item">
                                    <div class="inner">
                                                                                <strong><div class="date">
    <time class="updated" datetime="2023-12-18T14:00:06+00:00">December 18, 2023</time>
    	<div class="clearfix"></div>
</div></strong>
                                        <div class="hdr-content">
                                            <div class="hdr-icon">
                                                <div class="hdr">Current Views &amp; News</div>
                                            </div>
