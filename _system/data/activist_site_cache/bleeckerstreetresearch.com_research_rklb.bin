<script>
  (function () {
    var STORAGE_KEY = 'bscm_disclosure_accepted';
    var EXPIRY_DAYS = 30;

    function isAccepted() {
      try {
        var stored = localStorage.getItem(STORAGE_KEY);
        if (!stored) return false;
        var data = JSON.parse(stored);
        if (!data || !data.ts) return false;
        return (new Date().getTime() - data.ts) < (EXPIRY_DAYS * 24 * 60 * 60 * 1000);
      } catch (e) { return false; }
    }

    function setAccepted() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify({ ts: new Date().getTime() }));
      } catch (e) {}
    }

    function showModal() {
      var overlay = document.getElementById('bscm-overlay');
      if (overlay) overlay.classList.add('bscm-visible');
      document.body.style.overflow = 'hidden';
    }

    function hideModal() {
      var overlay = document.getElementById('bscm-overlay');
      if (overlay) overlay.classList.remove('bscm-visible');
      document.body.style.overflow = '';
    }

    function init() {
      if (isAccepted()) return;
      var checkbox = document.getElementById('bscm-checkbox');
      var btn = document.getElementById('bscm-accept-btn');
      if (!checkbox || !btn) return;

      checkbox.addEventListener('change', function () {
        btn.classList.toggle('bscm-enabled', this.checked);
      });

      btn.addEventListener('click', function () {
        if (!checkbox.checked) return;
        setAccepted();
        hideModal();
      });

      showModal();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

  </body>
</html>
