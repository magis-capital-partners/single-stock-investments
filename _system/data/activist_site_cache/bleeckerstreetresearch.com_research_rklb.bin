                <img data-stretch="false" data-src="https://images.squarespace-cdn.com/content/v1/61367dd182986f4319c4dd18/5c8f1506-c6ba-4936-b78a-691cfacd1902/Screenshot+2025-02-25+002424.png" data-image="https://images.squarespace-cdn.com/content/v1/61367dd182986f4319c4dd18/5c8f1506-c6ba-4936-b78a-691cfacd1902/Screenshot+2025-02-25+002424.png" data-image-dimensions="863x591" data-image-focal-point="0.5,0.5" alt="" data-load="false" elementtiming="system-image-block" data-sqsp-image-classic-block-image src="https://images.squarespace-cdn.com/content/v1/61367dd182986f4319c4dd18/5c8f1506-c6ba-4936-b78a-691cfacd1902/Screenshot+2025-02-25+002424.png" width="863" height="591" alt="" sizes="(max-width: 640px) 100vw, (max-width: 767px) 100vw, 100vw" style="display:block;object-fit: cover; width: 100%; height: 100%; object-position: 50% 50%" onload="this.classList.add(&quot;loaded&quot;)" srcset="https://images.squarespace-cdn.com/content/v1/61367dd182986f4319c4dd18/5c8f1506-c6ba-4936-b78a-691cfacd1902/Screenshot+2025-02-25+002424.png?format=100w 100w, https://images.squarespace-cdn.com/content/v1/61367dd182986f4319c4dd18/5c8f1506-c6ba-4936-b78a-691cfacd1902/Screenshot+2025-02-25+002424.png?format=300w 300w, https://images.squarespace-cdn.com/content/v1/61367dd182986f4319c4dd18/5c8f1506-c6ba-4936-b78a-691cfacd1902/Screenshot+2025-02-25+002424.png?format=500w 500w, https://images.squarespace-cdn.com/content/v1/61367dd182986f4319c4dd18/5c8f1506-c6ba-4936-b78a-691cfacd1902/Screenshot+2025-02-25+002424.png?format=750w 750w, https://images.squarespace-cdn.com/content/v1/61367dd182986f4319c4dd18/5c8f1506-c6ba-4936-b78a-691cfacd1902/Screenshot+2025-02-25+002424.png?format=1000w 1000w, https://images.squarespace-cdn.com/content/v1/61367dd182986f4319c4dd18/5c8f1506-c6ba-4936-b78a-691cfacd1902/Screenshot+2025-02-25+002424.png?format=1500w 1500w, https://images.squarespace-cdn.com/content/v1/61367dd182986f4319c4dd18/5c8f1506-c6ba-4936-b78a-691cfacd1902/Screenshot+2025-02-25+002424.png?format=2500w 2500w" loading="lazy" decoding="async" data-loader="sqs">

            </div>
          </div>
        
