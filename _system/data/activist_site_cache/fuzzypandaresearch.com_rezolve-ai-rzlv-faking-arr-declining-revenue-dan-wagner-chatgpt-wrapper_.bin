  width: 75%;
 }

 #consent-form {
  background-color: white;
  padding: 20px;
  position: fixed;
  top: 10vh;
  bottom: 10vh;
  left: 10vh;
  right: 10vh;
  box-shadow: 5px 5px 5px rgba(0, 0, 0, 0.2);
  border-radius: 4px;
  border: 1px solid rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
  justify-content: center;
 }

 .button {
  width: 200px !important;
  font-size: 16px;
  padding: 10px 2px;
  background-color: #4ac4d6;
  color: white;
  border: none;
  border-radius: 20px;
  text-align: center;
  box-sizing: content-box;
  text-decoration: none;
  margin: auto;
  margin-top: 20px;
 }

 \@media all and (max-width: 700px) {
  #consent-form {
   top: 0;
   bottom: 0;
   left: 0;
   right: 0;
  }

  .button {
   margin-top: 10px;
   margin-bottom: 10px;
  }

  h5 {
   font-size: 1.5em;
  }
 }

 .consentText {
  padding: 0 10px 0 10px;
  height: 80vh;
  overflow-y: scroll;
  margin-bottom: 10px;
 }
</style>
