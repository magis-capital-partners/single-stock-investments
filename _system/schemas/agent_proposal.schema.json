{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "magis.agent_proposal.v1",
  "title": "Magis structured agent write-back proposal",
  "type": "object",
  "required": ["proposal_id", "agent", "kind", "ticker", "summary", "provenance"],
  "properties": {
    "proposal_id": {"type": "string", "minLength": 8},
    "agent": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "enum": ["claim", "memory", "valuation_assumption", "thesis_update"]},
    "ticker": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "payload": {"type": "object"},
    "provenance": {
      "type": "object",
      "required": ["source_paths"],
      "properties": {
        "source_paths": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "as_of": {"type": ["string", "null"]}
      }
    },
    "status": {"type": "string", "enum": ["pending_human_review"]}
  }
}
