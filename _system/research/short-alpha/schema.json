{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "short-alpha-positions",
  "title": "Short Alpha position ledger",
  "description": "Open shorts only. Names that fit live in candidates.json. Lenses live in frameworks.json. A position ticker must exist as a candidate.",
  "type": "object",
  "required": ["schema_version", "as_of", "ideas"],
  "properties": {
    "schema_version": {"type": "string"},
    "as_of": {"type": "string", "format": "date"},
    "currency": {"type": "string"},
    "ideas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ticker", "position", "check_ins"],
        "properties": {
          "ticker": {"type": "string"},
          "position": {
            "type": "object",
            "required": ["shares", "opened_price", "opened_date", "split_adjustment_factor"],
            "properties": {
              "shares": {"type": "number", "exclusiveMaximum": 0},
              "opened_price": {"type": "number", "exclusiveMinimum": 0},
              "opened_date": {"type": "string", "format": "date"},
              "split_adjustment_factor": {"type": "number", "exclusiveMinimum": 0}
            }
          },
          "check_ins": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["date", "price", "hypothesis_state", "note"]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "required": ["ticker", "stage", "frameworks", "hypothesis", "sources"],
      "properties": {
        "stage": {"enum": ["lead", "researching", "ic", "live", "closed", "rejected"]},
        "origin": {"enum": ["position", "activist_index", "filing_furnace", "browser_draft", "fugazi_scorecard"]}
      }
    }
  }
}
