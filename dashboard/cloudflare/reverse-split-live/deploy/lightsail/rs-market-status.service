# Box R: public exchange halt / short-sale-restriction observer.
# Public HTTPS (nasdaqtrader.com) into the research R2 bucket. It holds its own
# lease (exchange_status_lease), so GitHub's observer and this one never write
# at the same time. Each run lasts at most 270 minutes and exits 0; systemd
# starts the next one.
[Unit]
Description=Reverse-split public market-status observer (box R)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=research
Group=research
WorkingDirectory=/srv/rs/repo
EnvironmentFile=/etc/reverse-split-live.env
EnvironmentFile=/etc/reverse-split-live.runtime.env
ExecStart=/srv/rs/repo/dashboard/cloudflare/reverse-split-live/deploy/lightsail/run.sh market-status

# A run that finds the lease held exits at once; 60 s keeps that polling cheap.
Restart=always
RestartSec=60

KillSignal=SIGTERM
TimeoutStopSec=60

MemoryHigh=384M
MemoryMax=512M
Nice=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
