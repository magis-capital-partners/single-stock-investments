# /etc/reverse-split-live.env on box R. Owner root, group research, mode 0640.
# Edit with `sudoedit /etc/reverse-split-live.env`. Never commit real values.
#
# Box R carries research credentials ONLY. It must never hold: Clear Street /
# DC-Execution keys, an NY4 SSH key, ThetaData credentials, an IB Gateway
# client id, or a GitHub token.

# Cloudflare: a NEW token made for this box (not the GitHub secret), limited to
# the research D1 database (single-stock-reverse-splits) and the R2 bucket
# (single-stock-reverse-splits-evidence), with the narrowest permissions the
# Cloudflare token screen offers. Revoke it to cut the box off instantly.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=e1cac493b315c8fd7398500dd1bfd687
# Defaults in collector.mjs; set only if the resources move.
#REVERSE_SPLIT_DATABASE_ID=de0ec6d5-9619-48be-b02e-d007456517ee
#REVERSE_SPLIT_EVIDENCE_BUCKET=single-stock-reverse-splits-evidence

# Market and reference data (same values as the GitHub secrets of the same name).
DATABENTO_API_KEY=
POLYGON_API_KEY=
#MASSIVE_API_KEY=

# IBKR Flex borrow report (HTTPS; no broker session).
IBKR_FLEX_BORROW_TOKEN=
IBKR_FLEX_BORROW_QUERY_ID=

# Do NOT set these here. They are GitHub-runner variables; run.sh removes them
# so the box can never queue GitHub runs:
#   RS_WARM_DISPATCH_TOKEN  GITHUB_REPOSITORY  GITHUB_OUTPUT  GITHUB_TOKEN  GH_TOKEN
